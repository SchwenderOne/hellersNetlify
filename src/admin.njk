---
layout: base.njk
title: "Admin-Bereich — Hellers Kaffees"
description: "Verwaltung und Moderation für Hellers Kaffees"
canonical: "https://hellerskaffees.com/admin/"
skipLinkHref: "#admin-content"
permalink: admin/index.html
---

<main class="admin-page" id="admin-content">
  <div class="wrapper">
    <header class="admin-header">
      <h1>Admin-Bereich</h1>
      <p class="admin-subtitle">Kommentar-Moderation & Verwaltung</p>
    </header>

    <!-- Auth Check Section (shown when not logged in as owner) -->
    <section class="admin-auth-required" id="admin-auth-required">
      <div class="admin-auth-card">
        <svg class="admin-lock-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor" stroke-width="2"/>
          <path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <h2>Zugang erforderlich</h2>
        <p>Diese Seite ist nur für Administratoren zugänglich.</p>
        <p id="admin-auth-status">Prüfe Anmeldestatus...</p>
      </div>
    </section>

    <!-- Admin Dashboard (shown only for owner) -->
    <section class="admin-dashboard" id="admin-dashboard" style="display: none;">
      
      <!-- Stats Overview -->
      <div class="admin-stats">
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-pending">0</span>
          <span class="admin-stat-label">Ausstehend</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-flagged">0</span>
          <span class="admin-stat-label">Markiert</span>
        </div>
        <div class="admin-stat-card">
          <span class="admin-stat-value" id="stat-total">0</span>
          <span class="admin-stat-label">Gesamt</span>
        </div>
      </div>

      <!-- Pending Comments Section -->
      <div class="admin-section">
        <h2 class="admin-section-title">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
            <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Ausstehende Kommentare
        </h2>
        <p class="admin-section-desc">Kommentare, die auf Freigabe warten. Markierte Kommentare werden nach <span id="review-time-display">24</span>h automatisch freigegeben.</p>
        
        <div class="admin-comments-list" id="pending-comments">
          <div class="admin-loading">Lade Kommentare...</div>
        </div>
      </div>

      <!-- All Comments Section -->
      <div class="admin-section">
        <h2 class="admin-section-title">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Alle Kommentare
        </h2>
        
        <div class="admin-filter-bar">
          <select id="filter-status" class="admin-filter-select">
            <option value="all">Alle Status</option>
            <option value="approved">Freigegeben</option>
            <option value="pending">Ausstehend</option>
            <option value="rejected">Abgelehnt</option>
          </select>
          <select id="filter-page" class="admin-filter-select">
            <option value="all">Alle Seiten</option>
          </select>
        </div>
        
        <div class="admin-comments-list" id="all-comments">
          <div class="admin-loading">Lade Kommentare...</div>
        </div>
      </div>

      <!-- Admin Access Management (Owner only) -->
      <div class="admin-section admin-access-section" id="admin-access-section" style="display: none;">
        <h2 class="admin-section-title">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 11a4 4 0 100-8 4 4 0 000 8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M6 21v-2a4 4 0 014-4h4a4 4 0 014 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Admin-Zugriff verwalten
        </h2>
        <p class="admin-section-desc">Gewähre weiteren Teammitgliedern Zugriff auf das Moderations-Dashboard.</p>

        <form class="admin-access-form" id="admin-access-form">
          <label for="admin-access-input" class="admin-access-label">E-Mail-Adresse hinzufügen</label>
          <div class="admin-access-input-group">
            <input type="email" id="admin-access-input" placeholder="person@beispiel.de" required />
            <button type="submit">Zugriff gewähren</button>
          </div>
          <p class="admin-access-message" id="admin-access-message" role="alert" aria-live="polite"></p>
        </form>

        <div class="admin-access-list" id="admin-access-list">
          <div class="admin-loading">Lade Administratoren...</div>
        </div>
      </div>

      <!-- Settings Section (Owner only) -->
      <div class="admin-section admin-settings-section" id="admin-settings-section" style="display: none;">
        <h2 class="admin-section-title">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="2"/>
            <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06a1.65 1.65 0 00.33-1.82 1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06a1.65 1.65 0 001.82.33H9a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Einstellungen
        </h2>
        <p class="admin-section-desc">Konfiguriere die Moderationseinstellungen.</p>

        <div class="admin-settings-group">
          <label for="review-time-input" class="admin-settings-label">
            <strong>Auto-Freigabe Zeit</strong>
            <span class="admin-settings-hint">Zeit bis markierte Kommentare automatisch freigegeben werden</span>
          </label>
          <div class="admin-settings-input-group">
            <input type="number" id="review-time-input" min="1" max="168" value="24" />
            <span class="admin-settings-unit">Stunden</span>
            <button type="button" id="save-review-time-btn" class="admin-settings-save-btn">Speichern</button>
          </div>
          <p class="admin-settings-message" id="review-time-message" role="alert" aria-live="polite"></p>
        </div>
      </div>

      <!-- Logout Button -->
      <div class="admin-logout-section">
        <button type="button" class="admin-logout-btn" id="admin-logout-btn">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Abmelden
        </button>
      </div>
    </section>
  </div>
</main>

<!-- Admin Script (Supabase SDK loaded via base layout) -->
<script src="/scripts/admin.js" defer></script>
